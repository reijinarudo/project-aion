# Copy this file to .env in the project root and fill in your own values.
# .env is listed in .gitignore. Never commit it.
# Any value here can also be set as a Windows environment variable (setx NAME value); that wins over .env.

# Required. Create a key at https://platform.openai.com/api-keys
# The key's project needs access to the Live API model below (paid usage tier; check your limits page).
OPENAI_API_KEY=sk-your-key-here

# How Aion addresses you. Leave empty and she asks.
AION_USER_NAME=

# Voice model and voice. See the OpenAI Live API docs for current model ids and voices.
AURORA_LIVE_MODEL=gpt-live-1
AURORA_VOICE=gleam

# Starting mode: default | lecture | grading | job_search | tech_support
AURORA_MODE=default

# Small text model that turns "add lunch with Sam to my calendar" into an event.
AURORA_EXTRACT_MODEL=gpt-5-mini

# Audio devices. Leave empty to auto-select. The device list prints at the top of every run
# (and at the top of logs/aurora_stdout.log when running the .exe). Use those index numbers here.
AURORA_IN_DEV=
AURORA_OUT_VB=
AURORA_OUT_MON=
# Name keywords used for auto-selection, comma separated, earliest wins.
AURORA_MIC_KEYWORDS=microphone
AURORA_MONITOR_KEYWORDS=headphones,speakers
# 1 = send audio only to VB-CABLE (you will not hear her unless you monitor the cable)
AURORA_NO_MONITOR=

# Google Calendar. 1 = skip it. To use it, see docs/integrations.md.
AURORA_NO_CALENDAR=1

# Optional file locations (relative paths are fine; defaults shown).
# AURORA_PROFILE_PATH=config/profile.md
# AURORA_MEMORY_PATH=memory/aion_memory.md

# Used by scripts/start_aion.bat to open VMagicMirror before Aion starts.
# Example: C:\Program Files\VMagicMirror\VMagicMirror.exe  (use your own install path)
VMAGICMIRROR_EXE=

# Wake word (optional, scriptspy/WakeWatcher.py)
# AURORA_WAKE_PHRASES=hello aion,hey aion
# AURORA_WAKE_DEBUG=1
# AURORA_VOSK_MODEL=models/vosk-model-small-en-us-0.15
